<Window x:Class="Clothesline.OcrTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别文字"
        Width="560" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#F7F4EE"
        FontFamily="Segoe UI"
        FontSize="13"
        Topmost="True"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="选中一部分再点复制或翻译。没有选中时，两个按钮都用全文。识别结果不会自动进剪贴板。"
                   TextWrapping="Wrap" Foreground="#4A4438" Margin="0,0,0,10"/>
        <TextBox x:Name="Body" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderBrush="#D9D0BF" Background="White" Padding="8" FontSize="14"/>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,8,0,8" Foreground="#4A4438" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制" Padding="12,4" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="翻译" Padding="12,4" Margin="0,0,8,0" Click="Translate_Click"/>
            <Button Content="关闭" Padding="12,4" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
