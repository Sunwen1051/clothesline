<Window x:Class="Clothesline.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clothesline"
        Title="Clothesline"
        Width="1280" Height="{x:Static local:PegZoom.DefaultLineHeight}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True"
        Left="0" Top="0">
    <!-- alpha=1 而不是全透明：分层窗口按像素 alpha 做鼠标命中，全透明会被系统穿透 -->
    <Grid x:Name="Root" Background="#01000000" MouseLeftButtonDown="Root_MouseDown">
        <!-- 注意：Root 不能挂 RenderTransform——会让 AllowsTransparency 分层窗口整块变白 -->
        <Path x:Name="Rope" Stroke="#8A6A4F" StrokeThickness="3.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              VerticalAlignment="Top"/>
        <ScrollViewer x:Name="PegScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Focusable="False"
                      PreviewMouseWheel="PegScroll_PreviewMouseWheel">
            <ItemsControl x:Name="Pegs" VerticalAlignment="Top" HorizontalAlignment="Left"
                          Margin="12,0,18,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,0,0,0" Background="Transparent" VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0" RenderTransform="{Binding Xf}"
                          MouseEnter="Peg_MouseEnter" MouseLeave="Peg_MouseLeave">
                        <Border Background="#F7F4EE" CornerRadius="7" Padding="5"
                                BorderBrush="#D9D0BF" BorderThickness="1" Margin="0,10,0,4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <Image Source="{Binding Bitmap}" Stretch="Uniform"
                                   Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}"
                                   Cursor="Hand"
                                   PreviewMouseLeftButtonDown="Peg_MouseDown"
                                   PreviewMouseMove="Peg_MouseMove"
                                   PreviewMouseLeftButtonUp="Peg_MouseUp"
                                   MouseRightButtonDown="Peg_RightDown"/>
                        </Border>
                        <Rectangle Width="12" Height="20" RadiusX="3" RadiusY="3"
                                   Fill="#C98F4E" Stroke="#8A5A28" StrokeThickness="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="已复制" FontSize="11" Foreground="#4A4438"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopyFeedback}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
