<Window x:Class="Clothesline.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        Width="420" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#F7F4EE" CornerRadius="8" BorderBrush="#D9D0BF" BorderThickness="1" Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="Toolbar" LastChildFill="False" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="关闭" Padding="8,2" Margin="6,0,0,0" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="识别文字" Padding="8,2" Margin="6,0,0,0" Click="Ocr_Click"/>
                <CheckBox x:Name="ThroughBox" Content="穿透" VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="Through_Changed" Unchecked="Through_Changed"/>
                <CheckBox x:Name="LockBox" Content="锁定" VerticalAlignment="Center"
                          Checked="Lock_Changed" Unchecked="Lock_Changed"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Image x:Name="Photo" Stretch="Uniform" Cursor="SizeAll"
                       MouseLeftButtonDown="Photo_MouseDown"
                       PreviewMouseWheel="Photo_MouseWheel"/>
                <Thumb x:Name="Sizer" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" DragDelta="Sizer_Drag">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#C98F4E" CornerRadius="2"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
            <TextBlock x:Name="Status" Grid.Row="2" Margin="0,6,0,0" FontSize="12" Foreground="#4A4438"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
